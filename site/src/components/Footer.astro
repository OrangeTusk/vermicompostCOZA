---
import { getSiteSettings } from '../lib/content';
const settings = await getSiteSettings();
---
<footer class="site-footer"><div class="footer-main container">
  <div class="footer-brand"><img src="/farm/logo.png" alt="Vermicompost Farm" width="160" height="72" /><p>Living soil products, made naturally in Pretoria.</p></div>
  <div><p class="footer-label">Contact</p><a href={`tel:${settings.phone.replace(/\s/g, '')}`}>{settings.phone}</a><br /><a href={`mailto:${settings.email}`}>{settings.email}</a></div>
  <div><p class="footer-label">Find your way</p><a href="/shop">Shop</a><br /><a href="/visit">Visit &amp; contact</a><br /><a href="/ordering">How ordering works</a></div>
</div><div class="footer-bottom container"><span>© {new Date().getFullYear()} Vermicompost Farm</span><span><a href="/privacy">Privacy</a> · Pretoria, South Africa</span></div></footer>
<style>
  .site-footer { padding: 56px 0 22px; background: var(--green-dark); color: #edf0e8; }.footer-main { display: grid; grid-template-columns: 1.5fr 1fr 1fr; gap: 48px; }
  .footer-brand img { width: 150px; margin: -16px 0 4px; filter: brightness(0) invert(1); }.footer-brand p { max-width: 300px; color: #cbd3c8; }
  .site-footer a { color: #edf0e8; font-size: .88rem; line-height: 2; text-underline-offset: 4px; }.footer-label { margin-bottom: 8px; color: #fff; font-size: .69rem; font-weight: 600; letter-spacing: .13em; text-transform: uppercase; }
  .footer-bottom { display: flex; justify-content: space-between; margin-top: 44px; padding-top: 18px; border-top: 1px solid rgb(255 255 255 / 17%); color: #aab7a8; font-size: .73rem; }.footer-bottom a { color: inherit; font-size: inherit; }
  @media (max-width: 700px) { .footer-main { grid-template-columns: 1fr; gap: 26px; } .footer-bottom { align-items: flex-start; flex-direction: column; gap: 6px; } }
</style>
