---
const { transparent = false } = Astro.props;
---

<header class:list={['site-header', { 'site-header--transparent': transparent }]}>
  <div class="header-inner">
    <a class="brand" href="/" aria-label="Vermicompost Farm home">
      <img src="/farm/logo.png" alt="Vermicompost Farm — 100% Organic" width="170" height="76" />
    </a>
    <nav aria-label="Primary navigation">
      <a href="/shop">Shop</a>
      <a href="/learn">Learn</a>
      <a href="/our-farm">Our farm</a>
      <a href="/visit">Visit &amp; contact</a>
    </nav>
    <a class="basket-link" href="/enquiry" aria-label="Open enquiry basket">
      Enquiry <span data-basket-count>0</span>
    </a>
    <button class="menu-button" type="button" aria-expanded="false" aria-controls="mobile-nav">Menu</button>
  </div>
  <nav class="mobile-nav" id="mobile-nav" aria-label="Mobile navigation" hidden>
    <a href="/shop">Shop</a><a href="/learn">Learn</a><a href="/our-farm">Our farm</a><a href="/visit">Visit &amp; contact</a><a href="/enquiry">Enquiry basket</a>
  </nav>
</header>

<script>
  const menuButton = document.querySelector<HTMLButtonElement>('.menu-button');
  const mobileNav = document.querySelector<HTMLElement>('#mobile-nav');
  menuButton?.addEventListener('click', () => {
    const open = menuButton.getAttribute('aria-expanded') === 'true';
    menuButton.setAttribute('aria-expanded', String(!open));
    if (mobileNav) mobileNav.hidden = open;
  });
</script>

<style>
  .site-header { position: relative; z-index: 50; border-bottom: 1px solid var(--rule); background: rgb(247 242 232 / 95%); }
  .site-header--transparent { position: absolute; inset: 0 0 auto; border-color: rgb(255 253 248 / 26%); background: linear-gradient(rgb(20 26 18 / 62%), transparent); color: var(--white); }
  .header-inner { width: var(--page); min-height: 92px; margin: auto; display: grid; grid-template-columns: 210px 1fr auto; align-items: center; gap: 24px; }
  .brand { display: block; width: 164px; }
  .brand img { width: 100%; height: auto; }
  .site-header--transparent .brand img { filter: brightness(0) invert(1); }
  nav { display: flex; justify-content: center; gap: clamp(20px, 3vw, 42px); }
  nav a, .basket-link { font-size: .8rem; font-weight: 600; letter-spacing: .07em; text-decoration: none; text-transform: uppercase; }
  nav a { position: relative; }
  nav a::after { content: ''; position: absolute; left: 0; right: 100%; bottom: -7px; height: 1px; background: currentColor; transition: right 180ms ease; }
  nav a:hover::after { right: 0; }
  .basket-link { display: flex; align-items: center; gap: 9px; }
  .basket-link span { min-width: 24px; height: 24px; display: inline-grid; place-items: center; border: 1px solid currentColor; border-radius: 50%; font-size: .72rem; }
  .menu-button { display: none; border: 0; background: transparent; color: inherit; font-weight: 600; text-transform: uppercase; }
  .mobile-nav { width: var(--page); margin: auto; padding: 0 0 26px; flex-direction: column; align-items: flex-start; }
  @media (max-width: 900px) { .header-inner { grid-template-columns: 1fr auto; min-height: 76px; } .header-inner > nav, .basket-link { display: none; } .menu-button { display: block; } .brand { width: 138px; } .mobile-nav:not([hidden]) { display: flex; } }
</style>
