---
const { transparent = false } = Astro.props;
---
<header class:list={['site-header', { 'site-header--transparent': transparent }]}>
  <div class="header-inner">
    <a class="brand" href="/" aria-label="Vermicompost Farm home"><img src="/farm/logo.png" alt="Vermicompost Farm" width="150" height="67" /></a>
    <nav class="desktop-nav" aria-label="Primary navigation"><a href="/shop">Shop</a><a href="/learn">Learn</a><a href="/our-farm">Our Farm</a><a href="/visit">Contact</a></nav>
    <a class="basket-link" href="/enquiry">Enquiry <span data-basket-count>0</span></a>
    <button class="menu-button" type="button" aria-expanded="false" aria-controls="mobile-nav">Menu</button>
  </div>
  <nav class="mobile-nav" id="mobile-nav" aria-label="Mobile navigation" hidden><a href="/shop">Shop</a><a href="/learn">Learn</a><a href="/our-farm">Our Farm</a><a href="/visit">Contact</a><a href="/enquiry">Enquiry <span data-basket-count>0</span></a></nav>
</header>
<script>
  const menuButton = document.querySelector<HTMLButtonElement>('.menu-button');
  const mobileNav = document.querySelector<HTMLElement>('#mobile-nav');
  const closeMenu = () => { if (menuButton && mobileNav) { menuButton.setAttribute('aria-expanded', 'false'); mobileNav.hidden = true; } };
  menuButton?.addEventListener('click', () => { const willOpen = menuButton.getAttribute('aria-expanded') !== 'true'; menuButton.setAttribute('aria-expanded', String(willOpen)); if (mobileNav) mobileNav.hidden = !willOpen; });
  document.addEventListener('keydown', (event) => { if (event.key === 'Escape') { closeMenu(); menuButton?.focus(); } });
  window.addEventListener('resize', () => { if (window.innerWidth > 900) closeMenu(); });
</script>
<style>
  .site-header { position: relative; z-index: 50; border-bottom: 1px solid var(--rule); background: rgb(247 242 232 / 96%); }
  .site-header--transparent { position: absolute; inset: 0 0 auto; border-color: rgb(255 253 248 / 25%); background: linear-gradient(rgb(16 21 15 / 64%), transparent); color: var(--white); }
  .header-inner { width: var(--page); min-height: 74px; margin: auto; display: grid; grid-template-columns: 180px 1fr auto; align-items: center; gap: 24px; }
  .brand { display: block; width: 145px; }.brand img { width: 100%; height: auto; }.site-header--transparent .brand img { filter: brightness(0) invert(1); }
  .desktop-nav { display: flex; justify-content: center; gap: clamp(22px, 3vw, 40px); }
  nav a, .basket-link { font-size: .77rem; font-weight: 600; letter-spacing: .06em; text-decoration: none; text-transform: uppercase; }
  nav a:hover, .basket-link:hover { text-decoration: underline; text-underline-offset: 6px; }
  .basket-link { display: flex; align-items: center; gap: 8px; }
  .basket-link span, .mobile-nav span { min-width: 22px; height: 22px; display: inline-grid; place-items: center; border: 1px solid currentColor; border-radius: 50%; font-size: .68rem; }
  .menu-button { display: none; border: 0; background: transparent; color: inherit; cursor: pointer; font-size: .77rem; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; }
  .mobile-nav { width: var(--page); margin: auto; padding: 8px 0 24px; flex-direction: column; align-items: flex-start; gap: 15px; }
  .mobile-nav:not([hidden]) { display: none; }
  @media (max-width: 900px) { .header-inner { grid-template-columns: 1fr auto; min-height: 68px; } .desktop-nav, .basket-link { display: none; } .menu-button { display: block; } .brand { width: 130px; } .mobile-nav:not([hidden]) { display: flex; } }
</style>
