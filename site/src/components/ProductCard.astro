---
import type { Product } from '../lib/types';
import { formatPrice } from '../data/products';
import ResponsiveImage from './ResponsiveImage.astro';
interface Props { product: Product; }
const { product } = Astro.props;
const firstVariant = product.variants[0];
const priceLabel = !firstVariant || firstVariant.price === null ? 'Enquire' : product.variants.length > 1 ? `From ${formatPrice(firstVariant.price)}` : formatPrice(firstVariant.price);
---
<article class="product-card" data-product-card data-category={product.category}>
  <a class="product-image" href={`/shop/${product.slug}`}><ResponsiveImage src={product.image} alt={product.name} sizes="(max-width: 600px) 100vw, (max-width: 900px) 50vw, 34vw" /></a>
  <div class="product-copy"><p class="category">{product.categoryLabel}</p><h3><a href={`/shop/${product.slug}`}>{product.name}</a></h3><p>{product.summary}</p>
    <div class="product-bottom"><strong>{priceLabel}</strong>{firstVariant && <button type="button" data-add-to-basket data-product-id={product.id} data-product-name={product.name} data-variant-id={firstVariant.id} data-variant-label={firstVariant.label} data-price={firstVariant.price ?? ''}>Add <span aria-hidden="true">+</span></button>}</div>
  </div>
</article>
<style>
  .product-card { min-width: 0; overflow: hidden; border: 1px solid var(--rule); background: var(--white); }.product-image { display: block; aspect-ratio: 4/3; overflow: hidden; background: var(--sage); }.product-image :global(img) { width: 100%; height: 100%; object-fit: cover; filter: saturate(.82); transition: transform 350ms ease; }.product-card:hover .product-image :global(img) { transform: scale(1.025); }
  .product-copy { padding: 20px; }.category { margin: 0 0 7px; color: var(--clay); font-size: .66rem; font-weight: 600; letter-spacing: .11em; text-transform: uppercase; } h3 { font-size: 1.65rem; } h3 a { text-decoration: none; }.product-copy > p:not(.category) { min-height: 54px; margin: 10px 0 20px; color: var(--muted); font-size: .86rem; line-height: 1.55; }
  .product-bottom { display: flex; justify-content: space-between; align-items: center; gap: 14px; padding-top: 14px; border-top: 1px solid var(--rule); }.product-bottom strong { color: var(--green); font-size: .8rem; }.product-bottom button { min-height: 36px; padding: 6px 12px; border: 1px solid var(--green); background: transparent; color: var(--green); cursor: pointer; font-size: .75rem; font-weight: 600; }.product-bottom button:hover { background: var(--green); color: var(--white); }
</style>
