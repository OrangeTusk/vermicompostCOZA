<script is:inline>
  (() => {
    const mount = document.getElementById('hero-player'); const hero = mount?.closest('.hero');
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const narrow = window.matchMedia('(max-width: 700px)').matches;
    const saveData = Boolean(navigator.connection && navigator.connection.saveData);
    if (!mount || !hero || reduced || narrow || saveData) return;
    let player; let loopTimer; const startAt = 84; const endAt = 105;
    window.onYouTubeIframeAPIReady = () => {
      player = new YT.Player('hero-player', { host: 'https://www.youtube-nocookie.com', videoId: 'mBTYp-bA-Ag', playerVars: { autoplay: 1, controls: 0, disablekb: 1, enablejsapi: 1, fs: 0, iv_load_policy: 3, playsinline: 1, rel: 0, start: startAt, end: endAt, origin: window.location.origin }, events: {
        onReady(event) { const iframe = event.target.getIframe(); iframe.setAttribute('tabindex', '-1'); iframe.setAttribute('aria-hidden', 'true'); event.target.mute(); event.target.playVideo(); loopTimer = window.setInterval(() => { if (event.target.getCurrentTime() >= endAt - .35) event.target.seekTo(startAt, true); }, 250); },
        onStateChange(event) { if (event.data === 1) hero.classList.add('hero--playing'); if (event.data === 0) { event.target.seekTo(startAt, true); event.target.playVideo(); } },
        onError() { hero.classList.remove('hero--playing'); }
      }});
    };
    const api = document.createElement('script'); api.src = 'https://www.youtube.com/iframe_api'; api.async = true; document.head.appendChild(api);
    document.addEventListener('visibilitychange', () => { if (!player) return; if (document.hidden) player.pauseVideo(); else { player.seekTo(Math.max(startAt, player.getCurrentTime()), true); player.playVideo(); } });
    window.addEventListener('pagehide', () => window.clearInterval(loopTimer), { once: true });
  })();
</script>
