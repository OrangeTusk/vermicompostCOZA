---
import type { HomePageContent } from '../lib/types';
import ResponsiveImage from './ResponsiveImage.astro';
interface Props { hero: HomePageContent }
const { hero } = Astro.props;
const getYouTubeId = (value: string) => { try { const url = new URL(value); if (url.hostname === 'youtu.be') return url.pathname.split('/').filter(Boolean)[0]; return url.searchParams.get('v') || url.pathname.match(/\/(?:embed|shorts)\/([^/?]+)/)?.[1]; } catch { return undefined; } };
const videoId = getYouTubeId(hero.videoUrl) || 'mBTYp-bA-Ag';
---
<section class="hero" aria-labelledby="hero-title" data-video-hero data-video-id={videoId} data-video-start={hero.videoStart} data-video-end={hero.videoEnd}>
  <ResponsiveImage class="hero-poster" src={hero.posterImage} alt={hero.posterAlt} loading="eager" sizes="100vw" width={1600} height={900} />
  <div class="hero-video" aria-hidden="true"><div id="hero-player"></div></div><div class="hero-shade" aria-hidden="true"></div>
  <div class="hero-copy container"><p class="hero-kicker">{hero.kicker}</p><h1 id="hero-title">{hero.heading}</h1><p>{hero.description}</p><div class="hero-actions"><a class="button button--paper" href={hero.primaryHref}>{hero.primaryLabel}</a><a class="secondary" href={hero.secondaryHref}>{hero.secondaryLabel}</a></div></div>
</section>
<script is:inline>
  (() => {
    const hero = document.querySelector('[data-video-hero]'); const mount = hero?.querySelector('#hero-player');
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches; const narrow = window.matchMedia('(max-width: 700px)').matches; const saveData = Boolean(navigator.connection && navigator.connection.saveData);
    if (!mount || !hero || reduced || narrow || saveData) return;
    let player; let loopTimer; const videoId = hero.dataset.videoId; const startAt = Number(hero.dataset.videoStart) || 0; const endAt = Math.max(Number(hero.dataset.videoEnd) || startAt + 20, startAt + 1);
    window.onYouTubeIframeAPIReady = () => { player = new YT.Player(mount, { host: 'https://www.youtube-nocookie.com', videoId, playerVars: { autoplay: 1, controls: 0, disablekb: 1, enablejsapi: 1, fs: 0, iv_load_policy: 3, playsinline: 1, rel: 0, start: startAt, end: endAt, origin: window.location.origin }, events: {
      onReady(event) { const iframe = event.target.getIframe(); iframe.setAttribute('tabindex', '-1'); iframe.setAttribute('aria-hidden', 'true'); event.target.mute(); event.target.playVideo(); loopTimer = window.setInterval(() => { if (event.target.getCurrentTime() >= endAt - .35) event.target.seekTo(startAt, true); }, 250); },
      onStateChange(event) { if (event.data === 1) hero.classList.add('hero--playing'); if (event.data === 0) { event.target.seekTo(startAt, true); event.target.playVideo(); } }, onError() { hero.classList.remove('hero--playing'); }
    }}); };
    const api = document.createElement('script'); api.src = 'https://www.youtube.com/iframe_api'; api.async = true; document.head.appendChild(api);
    document.addEventListener('visibilitychange', () => { if (!player) return; if (document.hidden) player.pauseVideo(); else player.playVideo(); }); window.addEventListener('pagehide', () => window.clearInterval(loopTimer), { once: true });
  })();
</script>
<style>
  .hero { position: relative; min-height: clamp(610px, 78svh, 760px); display: flex; align-items: center; overflow: hidden; background: var(--ink); color: var(--white); isolation: isolate; }
  :global(.hero-poster), .hero-video, .hero-shade { position: absolute; inset: 0; }:global(.hero-poster) { width: 100%; height: 100%; object-fit: cover; filter: saturate(.72); }.hero-video { z-index: 1; opacity: 0; pointer-events: none; transition: opacity .8s ease; }.hero--playing .hero-video { opacity: 1; }
  .hero-video :global(iframe) { position: absolute; left: 50%; top: 50%; width: max(100vw, 177.78vh); height: max(100vh, 56.25vw); transform: translate(-50%, -50%) scale(1.04); border: 0; filter: saturate(.68) contrast(1.03); pointer-events: none; }
  .hero-shade { z-index: 2; background: linear-gradient(90deg, rgb(17 23 16 / 82%) 0%, rgb(38 28 20 / 52%) 62%, rgb(17 23 16 / 30%) 100%); }
  .hero-copy { position: relative; z-index: 3; padding-top: 74px; }.hero-kicker { margin-bottom: 14px; font-size: .72rem; font-weight: 600; letter-spacing: .16em; text-transform: uppercase; }.hero h1 { max-width: 760px; white-space: pre-line; font-size: clamp(3.4rem, 7vw, 6.6rem); line-height: .96; }.hero-copy > p:not(.hero-kicker) { max-width: 580px; margin: 22px 0 26px; color: #f1eee7; font-family: var(--serif); font-size: clamp(1.12rem, 1.7vw, 1.38rem); line-height: 1.48; }.hero-actions { display: flex; align-items: center; gap: 22px; }.secondary { font-size: .84rem; font-weight: 600; text-underline-offset: 6px; }
  @media (max-width: 700px) { .hero { min-height: 690px; align-items: flex-end; }.hero-copy { padding: 112px 0 68px; }.hero-actions { align-items: flex-start; flex-direction: column; gap: 16px; } }
</style>
