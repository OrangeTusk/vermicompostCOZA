---
import BaseLayout from '../layouts/BaseLayout.astro';
import VideoHero from '../components/VideoHero.astro';
import ProductCard from '../components/ProductCard.astro';
import ResponsiveImage from '../components/ResponsiveImage.astro';
import { getHomePage, getProducts, getSiteSettings } from '../lib/content';
const [page, products, settings] = await Promise.all([getHomePage(), getProducts(), getSiteSettings()]);
const selected = page.featuredProductIds.map((id) => products.find((product) => product.id === id)).filter(Boolean);
const featured = (selected.length === 3 ? selected : products.filter((product) => product.featured).slice(0, 3)) as typeof products;
---
<BaseLayout title="Vermicompost Farm" description="Organic vermicompost, red wigglers and living soil products made naturally in Pretoria." transparentHeader>
  <VideoHero hero={page} />
  <section class="section products"><div class="container">
    <div class="section-heading"><div><p class="eyebrow">{page.featuredEyebrow}</p><h2>{page.featuredTitle}</h2></div><div><p>{page.featuredIntro}</p><a class="text-link" href="/shop">See all products →</a></div></div>
    <div class="product-grid">{featured.map((product) => <ProductCard product={product} />)}</div>
  </div></section>
  <section class="section value"><div class="container value-grid">
    <div class="value-image"><ResponsiveImage src={page.valueImage} alt={page.valueImageAlt} sizes="(max-width: 840px) 100vw, 45vw" width={900} height={960} /></div>
    <div class="value-copy"><p class="eyebrow">{page.valueEyebrow}</p><h2>{page.valueTitle}</h2><p class="lede">{page.valueBody}</p><div class="benefits">{page.benefits.slice(0, 3).map((benefit) => <div><h3>{benefit.title}</h3><p>{benefit.text}</p></div>)}</div><a class="button button--ghost" href="/our-farm">How the farm works</a></div>
  </div></section>
  <section class="contact"><div class="container contact-inner"><div><p class="eyebrow">Visit or get in touch</p><h2>{page.contactTitle}</h2><p>{page.contactBody}</p></div><div class="contact-actions"><a class="button button--paper" href={`https://wa.me/${settings.whatsapp}?text=Hello%20Nico%2C%20I%20have%20a%20question%20about%20Vermicompost%20Farm.`} target="_blank" rel="noreferrer">WhatsApp Nico ↗</a><a href="/visit">Contact details and directions →</a></div></div></section>
</BaseLayout>
<style>
  .products { background: var(--paper); }.section-heading h2 { max-width: 650px; }.section-heading p { color: var(--muted); }.product-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }
  .value { border-top: 1px solid var(--rule); background: var(--white); }.value-grid { display: grid; grid-template-columns: .9fr 1.1fr; gap: clamp(42px, 8vw, 96px); align-items: center; }.value-image :global(img) { width: 100%; aspect-ratio: 4/4.25; object-fit: cover; filter: saturate(.8); }.value-copy .lede { margin: 20px 0 28px; }.benefits { margin-bottom: 28px; border-top: 1px solid var(--rule); }.benefits > div { display: grid; grid-template-columns: minmax(150px, .55fr) 1fr; gap: 20px; padding: 15px 0; border-bottom: 1px solid var(--rule); }.benefits h3 { font-size: 1.2rem; }.benefits p { margin: 0; color: var(--muted); font-size: .86rem; }
  .contact { padding: clamp(60px, 8vw, 88px) 0; background: var(--green-dark); color: var(--white); }.contact-inner { display: grid; grid-template-columns: 1.25fr .75fr; gap: 60px; align-items: end; }.contact .eyebrow { color: #d4dfd0; }.contact h2 { max-width: 750px; font-size: clamp(2.8rem, 5vw, 4.7rem); }.contact p:not(.eyebrow) { max-width: 650px; margin: 18px 0 0; color: #d3dbd0; }.contact-actions { display: flex; align-items: flex-start; flex-direction: column; gap: 18px; }.contact-actions > a:last-child { font-size: .82rem; font-weight: 600; text-underline-offset: 5px; }
  @media (max-width: 840px) { .product-grid { grid-template-columns: 1fr 1fr; }.product-grid > :last-child { grid-column: 1/-1; max-width: calc(50% - 11px); }.value-grid, .contact-inner { grid-template-columns: 1fr; } .value-image :global(img) { aspect-ratio: 16/9; } }
  @media (max-width: 580px) { .product-grid { grid-template-columns: 1fr; }.product-grid > :last-child { grid-column: auto; max-width: none; }.benefits > div { grid-template-columns: 1fr; gap: 4px; } }
</style>
