---
import BaseLayout from '../layouts/BaseLayout.astro';
import VideoHero from '../components/VideoHero.astro';
import { getHomeHero, getProducts } from '../lib/content';
import { formatPrice } from '../data/products';
const featured = (await getProducts()).filter((product) => product.featured).slice(0, 3);
const hero = await getHomeHero();
---
<BaseLayout title="Vermicompost Farm" description="Organic vermicompost, red wigglers and living soil products made naturally in Pretoria." transparentHeader>
  <VideoHero hero={hero} />
  <section class="proof" aria-label="Farm qualities"><div class="container proof-grid"><span><b>01</b> 100% organic</span><span><b>02</b> Farm produced</span><span><b>03</b> Living microbes</span><span><b>04</b> Pretoria grown</span></div></section>
  <section class="section"><div class="container">
    <div class="section-heading"><div><p class="eyebrow">From our farm</p><h2>Feed the soil.<br />The soil feeds everything.</h2></div><div><p class="lede">Naturally nutrient-rich products for gardeners who want healthier plants, more resilient soil and less waste.</p><a class="small-link" href="/shop">Browse the full farm shop <span>→</span></a></div></div>
    <div class="product-grid">{featured.map((product, index) => <article class="product-card paper-card"><a href={`/shop/${product.slug}`} aria-label={`View ${product.name}`}><div class="image-wrap"><img src={product.image} alt={product.name} loading="lazy" /><span class="card-number">0{index + 1}</span></div><div class="card-copy"><div><h3>{product.name}</h3><p>{product.summary}</p></div><strong>{formatPrice(product.variants[0]?.price ?? null)}</strong></div></a></article>)}</div>
  </div></section>
  <section class="section process-section"><div class="container process-grid">
    <div class="process-photo"><img src="/farm/windrows.jpg" alt="Windrows and worm bins on the farm" loading="lazy" /><p>A ten-week transformation, guided by millions of quiet workers.</p></div>
    <div><p class="eyebrow">How black gold is made</p><h2>Slow work.<br />Living results.</h2><ol class="steps"><li><span>01</span><div><h3>Prepare</h3><p>Horse manure and wood shavings are pre-composted for several weeks.</p></div></li><li><span>02</span><div><h3>Let the worms work</h3><p>Red wigglers turn the prepared material into stable, microbe-rich vermicast.</p></div></li><li><span>03</span><div><h3>Sift and share</h3><p>After roughly ten weeks, the finished compost is sifted and ready for your garden.</p></div></li></ol><a class="button button--ghost" href="/our-farm">See how the farm works <span>→</span></a></div>
  </div></section>
  <section class="section benefits"><div class="container">
    <div class="section-heading"><div><p class="eyebrow">Why vermicompost</p><h2>More life beneath<br />every plant.</h2></div><p class="lede">A small amount of mature vermicompost helps soil hold water, improves its structure and introduces a diverse community of beneficial organisms.</p></div>
    <div class="benefit-grid"><article><span>01</span><h3>Gentle nutrition</h3><p>Plant nutrients are released steadily in natural forms.</p></article><article><span>02</span><h3>Better soil structure</h3><p>Support both drainage and moisture retention around roots.</p></article><article><span>03</span><h3>Living biology</h3><p>Add the microbes that help a healthy soil system function.</p></article><article><span>04</span><h3>Less waste</h3><p>Turn useful organic matter into productive garden fertility.</p></article></div>
  </div></section>
  <section class="section home-story"><div class="container home-story-grid"><div class="home-story-copy"><p class="eyebrow">A real working farm</p><h2>Made slowly in Montana, Pretoria.</h2><p class="lede">Meet the red wigglers, see the production bins and learn why patient composting produces something no synthetic shortcut can copy.</p><a class="button button--ghost" href="/our-farm">Meet the farm <span>→</span></a></div><div class="home-story-photo"><img src="/farm/worm-bins-open.jpg" alt="Open worm bins at Vermicompost Farm" loading="lazy" /><span>Farm notebook · Montana</span></div></div></section>
  <section class="location-band"><div class="container location-grid"><div><p class="eyebrow">Collection · delivery · tours</p><h2>Find us in Pretoria—or start with a message.</h2></div><div><p>Arrange collection, ask about local delivery or book a short information tour with Nico.</p><div class="location-actions"><a class="button button--paper" href="/visit">Visit the farm <span>→</span></a><a class="location-link" href="https://wa.me/27828547255?text=Hello%20Nico%2C%20I%20have%20a%20question%20about%20Vermicompost%20Farm." target="_blank" rel="noreferrer">WhatsApp Nico ↗</a></div></div></div></section>
</BaseLayout>
<style>
  .proof { border-bottom: 1px solid var(--rule); background: var(--white); }.proof-grid { min-height: 92px; display: grid; grid-template-columns: repeat(4, 1fr); align-items: center; }.proof span { padding: 8px 18px; border-right: 1px solid var(--rule); font-size: .76rem; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; }.proof span:first-child { padding-left: 0; }.proof span:last-child { border: 0; }.proof b { margin-right: 10px; color: var(--clay); font-family: var(--serif); font-size: 1rem; }
  .small-link { display: inline-flex; gap: 16px; margin-top: 18px; color: var(--green); font-size: .82rem; font-weight: 600; text-underline-offset: 6px; }.product-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }.product-card { transition: transform 180ms ease, box-shadow 180ms ease; }.product-card:hover { transform: translateY(-5px) rotate(-.15deg); box-shadow: 9px 12px 0 rgb(106 73 50 / 9%); }.product-card a { display: block; text-decoration: none; }.image-wrap { position: relative; aspect-ratio: 4 / 3; overflow: hidden; background: var(--sage); }.image-wrap img { width: 100%; height: 100%; object-fit: cover; filter: saturate(.84) contrast(.96); transition: transform 500ms ease; }.product-card:hover img { transform: scale(1.035); }.card-number { position: absolute; left: 14px; top: 14px; width: 40px; height: 40px; display: grid; place-items: center; background: var(--paper); color: var(--soil); font-family: var(--serif); }.card-copy { min-height: 136px; display: flex; justify-content: space-between; gap: 18px; padding: 24px; }.card-copy h3 { font-size: 1.65rem; line-height: 1.1; }.card-copy p { margin: 9px 0 0; color: var(--muted); font-size: .86rem; }.card-copy strong { flex: 0 0 auto; color: var(--green); font-size: .8rem; }
  .process-section { background: var(--white); }.process-grid { display: grid; grid-template-columns: minmax(0, .88fr) minmax(0, 1.12fr); gap: clamp(42px, 8vw, 120px); align-items: center; }.process-photo { position: relative; padding: 18px 18px 76px; border: 1px solid var(--rule); background: var(--paper); transform: rotate(-1.2deg); box-shadow: var(--shadow); }.process-photo img { width: 100%; aspect-ratio: 4/4.5; object-fit: cover; }.process-photo p { position: absolute; left: 26px; right: 26px; bottom: 16px; margin: 0; color: var(--soil); font-family: var(--serif); font-style: italic; }.steps { margin: 44px 0; padding: 0; list-style: none; }.steps li { display: grid; grid-template-columns: 58px 1fr; gap: 22px; padding: 24px 0; border-top: 1px solid var(--rule); }.steps li:last-child { border-bottom: 1px solid var(--rule); }.steps > li > span { color: var(--clay); font-family: var(--serif); font-size: 1.15rem; }.steps h3 { font-size: 1.55rem; }.steps p { margin: 7px 0 0; color: var(--muted); font-size: .93rem; }
  .benefits { background: var(--paper); }.benefit-grid { display: grid; grid-template-columns: repeat(4, 1fr); border-block: 1px solid var(--rule); }.benefit-grid article { min-height: 245px; padding: 28px; border-right: 1px solid var(--rule); }.benefit-grid article:last-child { border: 0; }.benefit-grid span { color: var(--clay); font-family: var(--serif); }.benefit-grid h3 { margin-top: 42px; font-size: 1.55rem; }.benefit-grid p { color: var(--muted); font-size: .88rem; }.home-story { background: var(--white); }.home-story-grid { display: grid; grid-template-columns: .85fr 1.15fr; gap: clamp(42px, 8vw, 110px); align-items: center; }.home-story-copy h2 { font-size: clamp(3.2rem, 5vw, 5.6rem); }.home-story-copy .lede { margin: 25px 0 30px; }.home-story-photo { position: relative; padding: 15px 15px 54px; border: 1px solid var(--rule); background: var(--paper); transform: rotate(.7deg); box-shadow: var(--shadow); }.home-story-photo img { width: 100%; aspect-ratio: 4/3; object-fit: cover; filter: saturate(.8); }.home-story-photo span { position: absolute; left: 22px; bottom: 15px; color: var(--soil); font-family: var(--serif); font-style: italic; }.location-band { padding: clamp(74px, 10vw, 120px) 0; background: var(--green-dark); color: var(--white); }.location-grid { display: grid; grid-template-columns: 1.2fr .8fr; gap: clamp(38px, 8vw, 110px); align-items: end; }.location-band .eyebrow { color: #d4dfd0; }.location-band h2 { font-size: clamp(3.2rem, 6vw, 6.3rem); }.location-grid > div:last-child > p { color: #d3dbd0; font-family: var(--serif); font-size: 1.25rem; }.location-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 24px; margin-top: 28px; }.location-link { color: var(--white); font-size: .82rem; font-weight: 600; text-underline-offset: 6px; }
  @media (max-width: 840px) { .proof-grid { grid-template-columns: 1fr 1fr; padding: 12px 0; }.proof span:nth-child(2) { border-right: 0; }.product-grid { grid-template-columns: 1fr 1fr; }.product-card:last-child { display: none; }.process-grid, .home-story-grid, .location-grid { grid-template-columns: 1fr; }.benefit-grid { grid-template-columns: 1fr 1fr; }.benefit-grid article:nth-child(2) { border-right: 0; }.benefit-grid article:nth-child(-n+2) { border-bottom: 1px solid var(--rule); } } @media (max-width: 560px) { .proof-grid, .product-grid, .benefit-grid { grid-template-columns: 1fr; }.proof span { padding: 12px 0; border-right: 0; border-bottom: 1px solid var(--rule); }.proof span:last-child { border-bottom: 0; }.product-card:last-child { display: block; }.benefit-grid article { min-height: auto; border-right: 0; border-bottom: 1px solid var(--rule); }.benefit-grid article:last-child { border-bottom: 0; }.benefit-grid h3 { margin-top: 24px; } }
</style>
