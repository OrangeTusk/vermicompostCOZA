---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { getSiteSettings } from '../lib/content';
const settings = await getSiteSettings();
const localBusiness = { '@context': 'https://schema.org', '@type': 'GardenStore', name: 'Vermicompost Farm', telephone: settings.phone, email: settings.email, address: { '@type': 'PostalAddress', streetAddress: 'Cnr 3rd & Dr van der Merwe', addressLocality: 'Montana, Pretoria', addressCountry: 'ZA' }, url: 'https://www.vermicompostfarm.co.za' };
---
<BaseLayout title="Visit and contact" description="Arrange collection, a local delivery or a worm farm information tour in Montana, Pretoria." structuredData={localBusiness}>
  <PageHero eyebrow="Visit & contact" title="Talk to the farm." intro="Ask a product question, arrange collection or book a short information tour." />
  <section class="section"><div class="container contact-grid">
    <div class="details"><p class="eyebrow">Vermicompost Farm</p><h2>Montana, Pretoria</h2><address>{settings.address.split('\n').map((line) => <>{line}<br /></>)}</address><a class="button" href={settings.mapUrl} target="_blank" rel="noreferrer">Open directions ↗</a></div>
    <div class="contact-card"><p class="eyebrow">Contact Nico</p><a class="phone" href={`tel:${settings.phone.replace(/\s/g, '')}`}>{settings.phone}</a><a href={`mailto:${settings.email}`}>{settings.email}</a><a class="button" data-whatsapp-contact href={`https://wa.me/${settings.whatsapp}?text=Hello%20Nico%2C%20I%20have%20a%20question%20about%20Vermicompost%20Farm.`} target="_blank" rel="noreferrer">Send a WhatsApp ↗</a></div>
  </div></section>
  <section class="visit-notes"><div class="container notes"><article><h3>Collection</h3><p>{settings.fulfilmentMessage}</p></article><article><h3>Local delivery</h3><p>Send your suburb and quantity. Availability and cost are confirmed personally.</p></article><article><h3>Farm tours</h3><p>Thirty-minute information tours are R250 per person and booked in advance.</p></article></div></section>
</BaseLayout>
<style>
  .contact-grid { display: grid; grid-template-columns: 1fr .8fr; gap: clamp(44px, 9vw, 120px); align-items: center; }.details h2 { font-size: clamp(2.8rem, 5vw, 4.8rem); }.details address { margin: 24px 0; color: var(--green); font-family: var(--serif); font-size: 1.3rem; font-style: normal; }.contact-card { display: flex; align-items: flex-start; flex-direction: column; padding: 34px; border: 1px solid var(--rule); background: var(--white); }.contact-card > a:not(.button) { margin-bottom: 8px; color: var(--green); text-underline-offset: 5px; }.contact-card .phone { font-family: var(--serif); font-size: 2rem; text-decoration: none; }.contact-card .button { margin-top: 18px; }
  .visit-notes { padding: 48px 0; border-top: 1px solid var(--rule); background: var(--white); }.notes { display: grid; grid-template-columns: repeat(3, 1fr); }.notes article { padding: 6px 28px; border-left: 1px solid var(--rule); }.notes article:first-child { padding-left: 0; border-left: 0; }.notes h3 { font-size: 1.45rem; }.notes p { margin: 8px 0 0; color: var(--muted); font-size: .88rem; }
  @media (max-width: 700px) { .contact-grid, .notes { grid-template-columns: 1fr; }.notes article, .notes article:first-child { padding: 20px 0; border-top: 1px solid var(--rule); border-left: 0; } }
</style>
