---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { getSiteSettings } from '../lib/content';
const settings = await getSiteSettings();
const localBusiness = { '@context': 'https://schema.org', '@type': 'GardenStore', name: 'Vermicompost Farm', telephone: settings.phone, email: settings.email, address: { '@type': 'PostalAddress', streetAddress: 'Cnr 3rd & Dr van der Merwe', addressLocality: 'Montana, Pretoria', addressCountry: 'ZA' }, url: 'https://www.vermicompostfarm.co.za' };
---
<BaseLayout title="Visit and contact" description="Arrange collection, a local delivery or a worm farm information tour in Montana, Pretoria." structuredData={localBusiness}>
  <PageHero eyebrow="Visit & contact" title="Come curious. Leave with better soil." intro="Collect farm products, arrange a local delivery or book a practical worm-farm information tour." image="/farm/trommel-sifter.jpg" />
  <section class="section"><div class="container contact-grid">
    <div class="contact-main"><p class="eyebrow">Find the farm</p><h2>Montana,<br />Pretoria.</h2><address>{settings.address.split('\n').map((line) => <>{line}<br /></>)}</address><div class="contact-actions"><a class="button" href={settings.mapUrl} target="_blank" rel="noreferrer">Open directions ↗</a><a class="button button--ghost" href={`tel:${settings.phone.replace(/\s/g, '')}`}>Call {settings.phone}</a></div></div>
    <div class="contact-notes paper-card"><div><span>01</span><h3>Collection</h3><p>{settings.fulfilmentMessage}</p></div><div><span>02</span><h3>Local delivery</h3><p>Tell us your suburb and order quantity. Delivery availability and cost are confirmed personally.</p></div><div><span>03</span><h3>Farm tours</h3><p>Thirty-minute information tours are R250 per person and must be booked in advance.</p></div></div>
  </div></section>
  <section class="contact-band"><div class="container"><p class="eyebrow">The quickest route</p><h2>Send Nico a WhatsApp.</h2><p>Questions, collection arrangements and product enquiries are all welcome.</p><a class="button button--paper" href={`https://wa.me/${settings.whatsapp}?text=Hello%20Nico%2C%20I%20have%20a%20question%20about%20Vermicompost%20Farm.`} target="_blank" rel="noreferrer">Start a conversation ↗</a><a class="email" href={`mailto:${settings.email}`}>Or email {settings.email}</a></div></section>
</BaseLayout>
<style>
  .contact-grid { display: grid; grid-template-columns: .9fr 1.1fr; gap: clamp(50px, 9vw, 120px); align-items: center; }.contact-main h2 { font-size: clamp(4rem, 7vw, 7rem); }.contact-main address { margin: 32px 0; color: var(--green); font-family: var(--serif); font-size: 1.45rem; font-style: normal; }.contact-actions { display: flex; flex-wrap: wrap; gap: 12px; }.contact-notes { padding: 10px 34px; }.contact-notes > div { display: grid; grid-template-columns: 44px 1fr; column-gap: 18px; padding: 28px 0; border-bottom: 1px solid var(--rule); }.contact-notes > div:last-child { border: 0; }.contact-notes span { color: var(--clay); font-family: var(--serif); }.contact-notes h3 { font-size: 1.55rem; }.contact-notes p { grid-column: 2; margin: 8px 0 0; color: var(--muted); font-size: .9rem; }.contact-band { padding: clamp(80px, 12vw, 150px) 0; background: var(--green-dark); color: var(--white); }.contact-band .eyebrow { color: #d2ddce; }.contact-band h2 { font-size: clamp(4rem, 8vw, 8rem); }.contact-band > .container > p:not(.eyebrow) { max-width: 600px; margin: 28px 0; color: #d0d8cd; font-family: var(--serif); font-size: 1.3rem; }.contact-band .email { display: inline-block; margin-left: 24px; color: #eef2eb; font-size: .82rem; text-underline-offset: 5px; }
  @media (max-width: 760px) { .contact-grid { grid-template-columns: 1fr; }.contact-band .email { display: block; margin: 20px 0 0; } }
</style>
