---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import ProductCard from '../../components/ProductCard.astro';
import { getProducts } from '../../lib/content';
import type { ProductCategory } from '../../lib/types';
const products = await getProducts();
const sections: Array<{ id: ProductCategory; title: string; text: string }> = [
  { id: 'compost-soil', title: 'Compost & soil', text: 'Finished vermicompost and soil-building blends.' },
  { id: 'worms-care', title: 'Worms & supplies', text: 'Everything needed to start or support a worm farm.' },
  { id: 'liquids', title: 'Liquid plant food', text: 'Fresh biological support for soil and foliage.' },
  { id: 'experiences', title: 'Farm experiences', text: 'See the process and learn from a working farm.' },
];
---
<BaseLayout title="Farm shop" description="Browse vermicompost, organic soil products, red wigglers, worm bedding, vermicompost tea and farm tours in Pretoria.">
  <PageHero eyebrow="The farm shop" title="Living products for living soil." intro="Choose what you need and send an enquiry. Nico will confirm availability, collection and local delivery." />
  <section class="section shop"><div class="container">
    {sections.map((section) => { const items = products.filter((product) => product.category === section.id); return items.length > 0 && <section class="category-section" aria-labelledby={`category-${section.id}`}><div class="category-heading"><div><p class="eyebrow">{items.length} <span>{items.length === 1 ? 'product' : 'products'}</span></p><h2 id={`category-${section.id}`}>{section.title}</h2></div><p>{section.text}</p></div><div class="shop-grid">{items.map((product) => <ProductCard product={product} />)}</div></section>; })}
    <aside class="bulk-note"><div><p class="eyebrow">Large quantities</p><h2>Need a cubic metre or more?</h2></div><div><p>Tell us what you are planting, how much you need and where it needs to go. We’ll confirm a sensible collection or delivery option.</p><a class="button button--ghost" href="/enquiry">Start a bulk enquiry</a></div></aside>
  </div></section>
</BaseLayout>
<style>
  .shop { background: var(--paper); }.category-section + .category-section { margin-top: clamp(64px, 8vw, 92px); }.category-heading { display: flex; justify-content: space-between; align-items: end; gap: 30px; margin-bottom: 26px; padding-bottom: 18px; border-bottom: 1px solid var(--rule); }.category-heading h2 { font-size: clamp(2.2rem, 4vw, 3.6rem); }.category-heading > p { max-width: 380px; margin: 0; color: var(--muted); font-size: .9rem; }.shop-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }.bulk-note { display: grid; grid-template-columns: 1fr 1fr; gap: 50px; margin-top: 82px; padding: 38px; border: 1px solid var(--rule); background: var(--white); }.bulk-note h2 { font-size: clamp(2.2rem, 4vw, 3.6rem); }.bulk-note > div:last-child { align-self: end; }.bulk-note > div:last-child p { color: var(--muted); }
  @media (max-width: 900px) { .shop-grid { grid-template-columns: 1fr 1fr; }.bulk-note { grid-template-columns: 1fr; gap: 18px; } } @media (max-width: 600px) { .category-heading { align-items: flex-start; flex-direction: column; gap: 8px; }.shop-grid { grid-template-columns: 1fr; } }
</style>
