---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
const turnstileKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---
<BaseLayout title="Enquiry basket" description="Review your Vermicompost Farm products and send an order enquiry by WhatsApp or email.">
  <PageHero eyebrow="Order enquiry" title="Gather what you need. We’ll confirm the rest." intro="This is an enquiry, not a checkout. The farm will personally confirm availability, collection, delivery and the final total." />
  <section class="section"><div class="container enquiry-grid">
    <div><div class="enquiry-heading"><h2>Your products</h2><a href="/shop">Continue shopping</a></div><div class="enquiry-items paper-card" data-enquiry-items><p class="basket-empty">Your enquiry basket is empty. <a href="/shop">Browse farm products</a>.</p></div><div class="total-line"><span>Estimated product total</span><strong data-basket-total>R0</strong></div><p class="price-note">Delivery, bulk quantities and current availability are confirmed before any order is final.</p><a class="button whatsapp" data-whatsapp-enquiry href="https://wa.me/27828547255" target="_blank" rel="noreferrer">Send by WhatsApp <span>↗</span></a></div>
    <form class="enquiry-form paper-card" data-enquiry-form><p class="eyebrow">Email alternative</p><h2>Tell us where to reply.</h2><div class="field-row"><label>Full name<input required name="name" autocomplete="name" /></label><label>Phone number<input required name="phone" autocomplete="tel" inputmode="tel" /></label></div><label>Email address<input required type="email" name="email" autocomplete="email" /></label><div class="field-row"><label>How would you receive it?<select name="fulfilment"><option>Collection</option><option>Local delivery</option><option>Not sure yet</option></select></label><label>Suburb or area<input name="suburb" autocomplete="address-level2" /></label></div><label>Anything we should know?<textarea name="note" rows="5" placeholder="Preferred date, bulk quantity, garden project or questions…"></textarea></label>{turnstileKey && <div class="cf-turnstile" data-sitekey={turnstileKey}></div>}<button class="button" type="submit">Send email enquiry <span>→</span></button><p class="form-status" data-form-status role="status"></p><p class="privacy-note">Your details are used only to respond to this enquiry.</p></form>
  </div></section>
  {turnstileKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
</BaseLayout>
<style>
  .enquiry-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(40px, 7vw, 90px); align-items: start; }.enquiry-heading { display: flex; justify-content: space-between; align-items: end; gap: 20px; margin-bottom: 18px; }.enquiry-heading h2, .enquiry-form h2 { font-size: clamp(2.5rem, 4vw, 4rem); }.enquiry-heading a { color: var(--green); font-size: .78rem; font-weight: 600; text-underline-offset: 5px; }.enquiry-items { padding: 8px 26px; }.enquiry-items :global(.basket-empty) { padding: 42px 0; color: var(--muted); font-family: var(--serif); font-size: 1.15rem; }.total-line { display: flex; justify-content: space-between; margin-top: 20px; padding: 16px 0; border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); }.total-line strong { color: var(--green); font-family: var(--serif); font-size: 1.45rem; }.price-note { margin: 10px 0 22px; color: var(--muted); font-size: .78rem; }.whatsapp { width: 100%; background: var(--green); }.enquiry-form { padding: clamp(26px, 4vw, 42px); }.enquiry-form h2 { margin-bottom: 28px; }.enquiry-form label { display: grid; gap: 7px; margin-bottom: 18px; color: var(--soil); font-size: .72rem; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; }.field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }.enquiry-form input, .enquiry-form select, .enquiry-form textarea { width: 100%; border: 1px solid var(--rule); border-radius: 0; background: var(--white); color: var(--ink); padding: 12px; font-size: .92rem; text-transform: none; }.enquiry-form input, .enquiry-form select { height: 48px; }.enquiry-form textarea { resize: vertical; }.enquiry-form button { width: 100%; margin-top: 5px; }.form-status { margin: 14px 0 0; color: var(--green); font-size: .82rem; }.form-status a { text-underline-offset: 4px; }.privacy-note { margin: 12px 0 0; color: var(--muted); font-size: .72rem; text-align: center; }
  @media (max-width: 850px) { .enquiry-grid { grid-template-columns: 1fr; } } @media (max-width: 560px) { .field-row { grid-template-columns: 1fr; } }
</style>
