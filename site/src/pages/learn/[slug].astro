---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import ResponsiveImage from '../../components/ResponsiveImage.astro';
import { getGuides, getProducts } from '../../lib/content';
import type { Guide, Product } from '../../lib/types';
export async function getStaticPaths() {
  const [guides, products] = await Promise.all([getGuides(), getProducts()]);
  return guides.map((guide) => ({ params: { slug: guide.slug }, props: { guide, related: guide.relatedProducts.map((slug) => products.find((product) => product.slug === slug)).filter(Boolean) } }));
}
interface Props { guide: Guide; related: Product[]; }
const { guide, related } = Astro.props;
const articleSchema = { '@context': 'https://schema.org', '@type': 'Article', headline: guide.title, description: guide.summary, image: new URL(guide.image, Astro.site).href, publisher: { '@type': 'Organization', name: 'Vermicompost Farm' } };
---
<BaseLayout title={guide.title} description={guide.summary} image={guide.image} structuredData={articleSchema}>
  <article>
    <header class="article-hero"><ResponsiveImage src={guide.image} alt={guide.title} loading="eager" sizes="100vw" width={1600} height={900} /><div class="article-shade"></div><div class="container article-title"><p><a href="/learn">Field notes</a> · Practical guide</p><h1>{guide.title}</h1><span>{guide.summary}</span></div></header>
    <div class="article-layout container"><aside><p>In this guide</p>{guide.sections.map((section, index) => <a href={`#section-${index + 1}`}>{String(index + 1).padStart(2, '0')} · {section.heading}</a>)}</aside><div class="article-body"><p class="intro">{guide.intro}</p>{guide.sections.map((section, index) => <section id={`section-${index + 1}`}><p class="section-number">0{index + 1}</p><h2>{section.heading}</h2>{section.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}{section.steps && <ol>{section.steps.map((step) => <li>{step}</li>)}</ol>}</section>)}</div></div>
  </article>
  <section class="section related"><div class="container"><div class="section-heading"><div><p class="eyebrow">Put it into practice</p><h2>Products for this guide.</h2></div><p class="lede">Farm-made materials to help you get started with confidence.</p></div><div class="related-grid">{related.map((product) => product && <ProductCard product={product} />)}</div></div></section>
</BaseLayout>
<style>
  .article-hero { position: relative; min-height: 470px; display: flex; align-items: flex-end; overflow: hidden; color: var(--white); }.article-hero > :global(img), .article-shade { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }.article-hero > :global(img) { filter: saturate(.75); }.article-shade { background: linear-gradient(0deg, rgb(20 25 18 / 86%), rgb(20 25 18 / 24%)); }.article-title { position: relative; padding-bottom: 54px; }.article-title p { font-size: .7rem; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; }.article-title p a { text-underline-offset: 4px; }.article-title h1 { max-width: 850px; font-size: clamp(3.2rem, 7vw, 6rem); }.article-title span { display: block; max-width: 660px; margin-top: 18px; font-family: var(--serif); font-size: 1.2rem; }.article-layout { display: grid; grid-template-columns: 230px minmax(0, 680px); gap: clamp(42px, 8vw, 100px); justify-content: center; padding-block: clamp(60px, 8vw, 90px); }.article-layout aside { position: sticky; top: 30px; align-self: start; padding: 20px; border: 1px solid var(--rule); background: var(--white); }.article-layout aside p { margin: 0 0 14px; color: var(--soil); font-size: .7rem; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; }.article-layout aside a { display: block; padding: 10px 0; border-top: 1px solid var(--rule); font-size: .78rem; text-decoration: none; }.article-body .intro { color: var(--green); font-family: var(--serif); font-size: clamp(1.35rem, 2.5vw, 1.75rem); line-height: 1.45; }.article-body section { padding-top: 52px; }.section-number { color: var(--clay); font-family: var(--serif); }.article-body h2 { margin-bottom: 20px; font-size: clamp(2.2rem, 3.5vw, 3.35rem); }.article-body section > p:not(.section-number), .article-body li { color: #4f544c; font-size: 1rem; line-height: 1.75; }.article-body ol { padding: 0; counter-reset: guide; list-style: none; }.article-body li { position: relative; padding: 16px 0 16px 44px; border-top: 1px solid var(--rule); counter-increment: guide; }.article-body li::before { content: counter(guide); position: absolute; left: 8px; top: 16px; color: var(--clay); font-family: var(--serif); }.related { background: var(--white); }.related-grid { max-width: 780px; display: grid; grid-template-columns: 1fr 1fr; gap: 22px; }
  @media (max-width: 760px) { .article-layout { grid-template-columns: 1fr; }.article-layout aside { position: static; }.related-grid { grid-template-columns: 1fr; } }
</style>
