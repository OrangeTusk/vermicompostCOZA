---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { getGuides } from '../../lib/content';
import ResponsiveImage from '../../components/ResponsiveImage.astro';
const guides = await getGuides();
---
<BaseLayout title="Learn" description="Practical guides to using vermicompost, starting a worm farm and brewing fresh vermicompost tea.">
  <PageHero eyebrow="Practical guides" title="Simple ways to work with living soil." intro="Short, practical notes from a working worm farm." />
  <section class="section"><div class="container guide-list">{guides.map((guide) => <article><a class="guide-image" href={`/learn/${guide.slug}`}><ResponsiveImage src={guide.image} alt={guide.title} sizes="(max-width: 700px) 100vw, 250px" width={500} height={375} /></a><div><h2><a href={`/learn/${guide.slug}`}>{guide.title}</a></h2><p>{guide.summary}</p><a class="text-link" href={`/learn/${guide.slug}`}>Read the guide →</a></div></article>)}</div></section>
  <section class="question"><div class="container"><div><p class="eyebrow">Need practical help?</p><h2>Bring your questions to the farm.</h2></div><div><p>Ask Nico about your garden, worm bin or soil problem—or arrange a short farm tour.</p><a class="button button--paper" href="/visit">Contact the farm</a></div></div></section>
</BaseLayout>
<style>
  .guide-list { max-width: 920px; }.guide-list article { display: grid; grid-template-columns: 250px 1fr; gap: 34px; align-items: center; padding: 28px 0; border-top: 1px solid var(--rule); }.guide-list article:last-child { border-bottom: 1px solid var(--rule); }.guide-image { overflow: hidden; }.guide-image :global(img) { width: 100%; aspect-ratio: 4/3; object-fit: cover; filter: saturate(.8); }.guide-list h2 { font-size: clamp(1.9rem, 3vw, 2.7rem); }.guide-list h2 a { text-decoration: none; }.guide-list p { margin: 10px 0 14px; color: var(--muted); }
  .question { padding: clamp(54px, 7vw, 76px) 0; background: var(--green-dark); color: var(--white); }.question .container { display: grid; grid-template-columns: 1.1fr .9fr; gap: 60px; align-items: end; }.question .eyebrow { color: #d8e2d3; }.question h2 { font-size: clamp(2.7rem, 5vw, 4.6rem); }.question p { color: #d2d9cf; }
  @media (max-width: 700px) { .guide-list article { grid-template-columns: 1fr; gap: 20px; }.guide-image :global(img) { aspect-ratio: 16/9; }.question .container { grid-template-columns: 1fr; gap: 18px; } }
</style>
